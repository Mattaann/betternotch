{
  "manifest_version": 2,
  "name": "BetterNotch Browser Audio",
  "version": "1.0.0",
  "description": "Show Firefox media and control playback in BetterNotch on this Mac.",
  "browser_specific_settings": {"gecko": {"id": "browser-audio@betternotch.app", "strict_min_version": "115.0"}},
  "permissions": ["storage", "tabs", "http://127.0.0.1/*", "<all_urls>"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "BetterNotch", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["media.js"], "all_frames": true}],
  "incognito": "not_allowed"
}
